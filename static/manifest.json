{
  "manifest_version": 3,
  "name": "字幕侧栏 Subtitle Sidebar",
  "version": "0.3.0",
  "description": "在 YouTube 和 B站视频右侧显示可滚动、可点击跳转、可搜索的双语字幕浮窗。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://www.bilibili.com/video/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
